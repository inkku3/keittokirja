# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/keittokirja

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# CORS configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase configuration (for migration)
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_auth_domain
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Static image serving configuration
# If SERVE_IMAGES_FROM_BACKEND=true the backend will serve files from IMAGES_STATIC_DIR
# and expose them under IMAGES_URL_PREFIX (e.g., /recipes/img/<id>.png).
# If false, images are expected to be served by the frontend or a CDN and image_path
# fields in the database should contain absolute or relative URLs accordingly.
SERVE_IMAGES_FROM_BACKEND=false
IMAGES_STATIC_DIR=./static/recipes/img
IMAGES_URL_PREFIX=/recipes/img
# Optional base URL to prefix relative image paths when serving from a CDN (leave empty to use relative paths)
IMAGES_BASE_URL=

